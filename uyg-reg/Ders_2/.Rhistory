data(ozone, package="faraway")
library(rpart)
(tmod <- rpart(O3 ~ .,ozone))
plot(tmod)
text(tmod)
plot(tmod,compress=T,uniform=T,branch=0.4)
text(tmod)
plot(jitter(predict(tmod)),residuals(tmod),xlab="Fitted",ylab="Residuals")
text(tmod)
plot(jitter(predict(tmod)),residuals(tmod),xlab="Fitted",ylab="Residuals")
